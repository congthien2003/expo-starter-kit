{
  "name": "expo-starter-kit",
  "description": "An Android/iOS Expo starter kit with NativeWind, shared UI, mock auth flows, session management, and opt-in push notifications.",
  "version": "1.0.0",
  "author": "CongThien",
  "homepage": "https://github.com/congthien2003/expo-starter-kit",
  "keywords": [
    "expo",
    "react-native",
    "starter-kit",
    "nativewind",
    "typescript"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint app components features constants context hooks lib models utils jest.setup.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --watch=false --runInBand"
  },
